# Postgres connection (Neon, Supabase, Railway, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/bworld"

# Paystack keys: https://dashboard.paystack.com/#/settings/developer
# Use the sk_test_ key while testing, sk_live_ when you go live.
PAYSTACK_SECRET_KEY="paste-your-paystack-secret-key-here"

# Your WhatsApp business number: country code + number, digits only (no + or spaces)
# Example for 0801 234 5678 in Nigeria: 2348012345678
NEXT_PUBLIC_WHATSAPP_NUMBER="2348012345678"

# Public URL of the site (used for the Paystack return link). Optional locally.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
